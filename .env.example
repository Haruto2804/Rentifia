# Cấu hình môi trường ứng dụng
APP_NAME=Rentifia
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Rentifia/public

# Cấu hình kết nối MySQL (WampServer)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rentifia_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Cấu hình gửi Mail (Gmail SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_gmail@gmail.com
MAIL_FROM_NAME="Rentifia"

